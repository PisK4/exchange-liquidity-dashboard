{
  "name": "edgex-ops-intelligence-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "build": "next build",
    "test:e2e": "playwright test",
    "openapi:generate": "openapi-typescript ../backend/docs/openapi.json -o lib/api/types.gen.ts",
    "openapi:check": "npm run openapi:generate && git diff --exit-code -- lib/api/types.gen.ts && git ls-files --error-unmatch lib/api/types.gen.ts > /dev/null"
  },
  "dependencies": {
    "@playwright/test": "^1.44.0",
    "chart.js": "^4.4.0",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.4.0"
  }
}
