{
  "openapi": "3.0.3",
  "info": { "title": "EdgeX Liquidity Dashboard V1 API", "version": "0.1.0" },
  "paths": {
    "/api/health": { "get": { "responses": { "200": { "description": "health" } } } },
    "/api/symbols": { "get": { "responses": { "200": { "description": "symbol mappings" } } } },
    "/api/symbols/coverage": { "get": { "responses": { "200": { "description": "coverage matrix" } } } },
    "/api/snapshot/liquidity": { "get": { "parameters": [{ "name": "symbol", "in": "query", "schema": { "type": "string" } }], "responses": { "200": { "description": "liquidity tab" } } } },
    "/api/snapshot/quality": { "get": { "parameters": [{ "name": "symbol", "in": "query", "schema": { "type": "string" } }], "responses": { "200": { "description": "quality tab" } } } },
    "/api/snapshot/share": { "get": { "parameters": [{ "name": "window", "in": "query", "schema": { "type": "string", "enum": ["24h", "7d", "30d"] } }], "responses": { "200": { "description": "market share tab" } } } },
    "/api/snapshot/top30": { "get": { "parameters": [{ "name": "surface", "in": "query", "schema": { "type": "string" } }, { "name": "platform", "in": "query", "schema": { "type": "string" } }], "responses": { "200": { "description": "top30 tab" } } } },
    "/api/collection-status": { "get": { "responses": { "200": { "description": "collector status" } } } },
    "/api/runtime-config": { "get": { "responses": { "200": { "description": "runtime config" } } } }
  }
}
