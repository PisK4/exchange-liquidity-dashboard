# Frontend build-time API endpoint. Must be reachable from the browser.
NEXT_PUBLIC_API_BASE=http://localhost:8080
# Optional SSR/internal API endpoint for Next.js server-side requests.
SERVER_API_BASE=http://localhost:8080

# Optional local fallback when config/edgex-liquidity-dashboard.yaml is absent.
# Main-config Database takes precedence unless --mysql-dsn or this env var is set.
DASHBOARD_MYSQL_DSN=root:root@tcp(127.0.0.1:3306)/edgex_dashboard?parseTime=true

# CoinGecko Demo API key. The config key Runtime.coingecko.api_key_env controls
# which environment variable the collector reads.
COINGECKO_DEMO_API_KEY=

# Optional process-level proxy fallback. Prefer configuring Runtime.exchange_proxy,
# Runtime.coingecko.proxy, and Runtime.ws_providers.*.proxy in the main config.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
