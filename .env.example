NEXT_PUBLIC_API_BASE=http://localhost:8080
DASHBOARD_ROLE=all
DASHBOARD_MYSQL_DSN=root:root@tcp(127.0.0.1:3306)/edgex_dashboard?parseTime=true

# CoinGecko Demo API key (only required when config/runtime.yaml has
# coingecko.enabled=true). Leave blank for local-only runs that bypass
# CoinGecko ingestion. The env var name is configurable via runtime.yaml's
# coingecko.api_key_env field — change it there if you have a Pro key under a
# different name.
COINGECKO_DEMO_API_KEY=
# Local-only egress proxy for CoinGecko, if your network needs one.
# Configure this through runtime.yaml's coingecko.proxy field instead of
# setting process-level HTTPS_PROXY / HTTP_PROXY — those would also route
# the 9 native exchange adapters through the proxy.
