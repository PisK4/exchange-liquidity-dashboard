FROM node:20-alpine AS deps
WORKDIR /app
COPY web/package.json ./package.json
COPY web/package-lock.json ./package-lock.json
RUN npm ci

FROM node:20-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY web/ ./
# NEXT_PUBLIC_* values are inlined into the client bundle by `next build`,
# so this ARG must hold the URL the user's browser will hit, not a Docker
# network alias. Setting NEXT_PUBLIC_API_BASE at container runtime has no
# effect on the already-built client JS.
ARG NEXT_PUBLIC_API_BASE=http://localhost:8080
ENV NEXT_PUBLIC_API_BASE=$NEXT_PUBLIC_API_BASE
RUN npm run build

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public
EXPOSE 3000
CMD ["node", "server.js"]
