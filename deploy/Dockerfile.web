FROM node:20-alpine AS deps
WORKDIR /app
COPY web/package.json ./package.json
COPY web/package-lock.json ./package-lock.json
RUN npm ci

FROM node:20-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY web/ ./
# NEXT_PUBLIC_* values are inlined into the client bundle by `next build`,
# so this ARG must hold the URL the user's browser will hit, not a Docker
# network alias. Setting NEXT_PUBLIC_API_BASE at container runtime has no
# effect on the already-built client JS.
ARG NEXT_PUBLIC_API_BASE=http://localhost:8080
ENV NEXT_PUBLIC_API_BASE=$NEXT_PUBLIC_API_BASE
# Opt into Next.js standalone output for this self-hosted image only.
# Vercel builds must NOT set this — see next.config.mjs.
ENV BUILD_STANDALONE=1
RUN npm run build

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --retries=5 --start-period=20s \
  CMD node -e "const http=require('http');const host=require('os').hostname();const req=http.get({host,port:3000,path:'/healthz',timeout:3000},res=>{process.exit(res.statusCode===200?0:1)});req.on('timeout',()=>req.destroy(new Error('timeout')));req.on('error',()=>process.exit(1));"
USER node
CMD ["node", "server.js"]
