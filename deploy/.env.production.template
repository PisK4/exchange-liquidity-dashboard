# EdgeX Ops Intelligence production deployment template.
# Copy to deploy/.env (which is gitignored) and edit before running
# `make -C deploy up`.
#
# Every value below is a *suggestion* sized for a single-tenant 4-CPU /
# 8 GiB host. Feel free to override any of them at runtime via
# `BACKEND_MEM_LIMIT=2g make -C deploy up` instead of editing this
# file in place.

# --- Publish bindings ------------------------------------------------
# Default 127.0.0.1 means "expose only to local processes" -- e.g.
# behind a reverse proxy on the same host. Set to 0.0.0.0 (or a
# specific NIC IP) to expose to the network. Never expose MySQL.
BACKEND_PUBLISH_HOST=127.0.0.1
BACKEND_PUBLISH_PORT=8080
WEB_PUBLISH_HOST=127.0.0.1
WEB_PUBLISH_PORT=3001
MYSQL_PUBLISH_HOST=127.0.0.1
MYSQL_PUBLISH_PORT=3306

# --- Runtime config source ------------------------------------------
# Production-like deployments pull the main edgex-ops-intelligence.yaml
# from Nacos. Local compose keeps USE_LOCAL_CONFIG=true in docker-compose.yaml.
USE_LOCAL_CONFIG=false
OPS_INTELLIGENCE_CONFIG_SOURCE=nacos
NACOS_CONFIG_SERVER_ADDR=nacos.example.internal:8848
# Optional split override. If set, these win over NACOS_CONFIG_SERVER_ADDR.
NACOS_CONFIG_SERVER_IP=
NACOS_CONFIG_SERVER_PORT=
NACOS_CONFIG_NAMESPACE=
NACOS_CONFIG_GROUP=DEFAULT_GROUP
NACOS_CONFIG_NAME=edgex-ops-intelligence.yaml
NACOS_CONFIG_USERNAME=
NACOS_CONFIG_PASSWORD=

# --- AWS Secrets Manager --------------------------------------------
# Region and secret id stay in env, matching edgex-bridge-server. The
# Nacos Aws block contains key names inside the JSON secret.
AWS_SM_ENABLE=true
AWS_SM_REGION=ap-southeast-1
AWS_SM_SECRET_ID=edgex/ops-intelligence

# --- Frontend URLs ---------------------------------------------------
# NEXT_PUBLIC_API_BASE is baked into the JS bundle at build time and
# must be reachable from the end-user's browser. Leave empty when the
# reverse proxy serves both / and /api from the same origin. After changing
# this value, rebuild the web image; setting it only at container runtime does
# not update the already-built browser bundle. docker-compose.yaml preserves
# an explicitly empty value here for same-origin deployments.
NEXT_PUBLIC_API_BASE=
# SERVER_API_BASE is used by Next.js SSR inside the container; keep it
# on the Docker internal network.
SERVER_API_BASE=http://backend:8080

# --- MySQL -----------------------------------------------------------
# Fill MYSQL_ROOT_PASSWORD only when using the bundled compose MySQL service.
# Do not put production RDS passwords or full DSNs in this tracked template.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=edgex_ops_intelligence
# Production DB values come from Nacos Database plus AWS SM-resolved Aws.DB*.
# Keep this empty unless doing a short-lived local/ops override.
# docker-compose.yaml intentionally preserves an explicitly empty value here;
# if this variable is omitted entirely, local file-backed compose falls back to
# the bundled MySQL DSN for developer convenience.
OPS_INTELLIGENCE_MYSQL_DSN=

# --- Module secrets and external URLs --------------------------------
# The backend runs with --role=all in deploy/docker-compose.yaml, so
# Liquidity, Listing, and Activity modules can all start from the same
# container. Secrets still must not be written into tracked YAML files;
# put real values in deploy/.env, Nacos, or a private config-dir.

# CoinGecko derivatives ingestion. The tracked runtime config points
# Runtime.coingecko.api_key_env at this variable. Leave empty when using
# the governed no-key path.
COINGECKO_DEMO_API_KEY=

# Listing Agent. Business push webhook URLs are configured in Nacos
# Alert.Push.Listing / Activity / Liquidity. Callback secret should come
# from AWS SM via Aws.ListingCallbackSecret, or this env only for local ops.
LARK_LISTING_CALLBACK_SECRET=
# Reference value for private runtime overlays. The current binary does
# not automatically map LISTING_DASHBOARD_BASE_URL into YAML; set
# Runtime.listing_agent.delivery.dashboard_base_url in the chosen config-dir.
LISTING_DASHBOARD_BASE_URL=

# Activity Agent. Business push webhook URLs are configured in Nacos Alert.Push.
# Decision token should come from AWS SM via Aws.ActivityDecisionToken, or this
# env only for local ops.
ACTIVITY_DECISION_TOKEN_SECRET=
# Reference value for private runtime overlays. The current binary does
# not automatically map ACTIVITY_DASHBOARD_BASE_URL into YAML; set
# Runtime.activity_agent.delivery.dashboard_base_url in the chosen config-dir.
ACTIVITY_DASHBOARD_BASE_URL=

# --- Egress proxy ----------------------------------------------------
# Empty by default. Set when the deployment sits behind a corporate
# egress proxy. The collector reads the EdgeX Ops Intelligence config file's
# exchange_proxy / coingecko.proxy / ws_providers.*.proxy first. HTTP_PROXY
# here only kicks in for code paths that build a transport without consulting
# the config file (currently: none, but reserved for future tooling).
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# Optional scoped proxies, usually for local Docker only. These are
# documentation/reference values for private config-dir overlays; the
# current binary does not automatically map them into YAML. Prefer these
# scoped config fields over process-wide HTTP_PROXY/HTTPS_PROXY:
#   EXCHANGE_PROXY            -> Runtime.exchange_proxy
#   COINGECKO_PROXY           -> Runtime.coingecko.proxy
#   LISTING_DELIVERY_PROXY    -> Runtime.listing_agent.delivery.proxy
#   ACTIVITY_SOURCE_PROXY     -> Runtime.activity_agent.source_proxy
#   ACTIVITY_DELIVERY_PROXY   -> Runtime.activity_agent.delivery.proxy
EXCHANGE_PROXY=
COINGECKO_PROXY=
LISTING_DELIVERY_PROXY=
ACTIVITY_SOURCE_PROXY=
ACTIVITY_DELIVERY_PROXY=

# --- Resource limits -------------------------------------------------
BACKEND_MEM_LIMIT=512m
BACKEND_CPUS=1.0
WEB_MEM_LIMIT=512m
WEB_CPUS=1.0
MYSQL_MEM_LIMIT=1g
MYSQL_CPUS=1.0
