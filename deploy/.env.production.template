# EdgeX Ops Intelligence production deployment template.
# Copy to deploy/.env (which is gitignored) and edit before running
# `make -C deploy up`.
#
# Every value below is a *suggestion* sized for a single-tenant 4-CPU /
# 8 GiB host. Feel free to override any of them at runtime via
# `BACKEND_MEM_LIMIT=2g make -C deploy up` instead of editing this
# file in place.

# --- Publish bindings ------------------------------------------------
# Default 127.0.0.1 means "expose only to local processes" -- e.g.
# behind a reverse proxy on the same host. Set to 0.0.0.0 (or a
# specific NIC IP) to expose to the network. Never expose MySQL.
BACKEND_PUBLISH_HOST=127.0.0.1
BACKEND_PUBLISH_PORT=8080
WEB_PUBLISH_HOST=127.0.0.1
WEB_PUBLISH_PORT=3001
MYSQL_PUBLISH_HOST=127.0.0.1
MYSQL_PUBLISH_PORT=3306

# --- Frontend URLs ---------------------------------------------------
# NEXT_PUBLIC_API_BASE is baked into the JS bundle at build time and
# must be reachable from the end-user's browser.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8080
# SERVER_API_BASE is used by Next.js SSR inside the container; keep it
# on the Docker internal network.
SERVER_API_BASE=http://backend:8080

# --- MySQL -----------------------------------------------------------
# Override BOTH MYSQL_ROOT_PASSWORD and the password embedded in
# OPS_INTELLIGENCE_MYSQL_DSN below if changing from the default.
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=edgex_ops_intelligence
OPS_INTELLIGENCE_MYSQL_DSN=root:root@tcp(mysql:3306)/edgex_ops_intelligence?parseTime=true

# --- Egress proxy ----------------------------------------------------
# Empty by default. Set when the deployment sits behind a corporate
# egress proxy. The collector reads the EdgeX Ops Intelligence config file's
# exchange_proxy / coingecko.proxy / ws_providers.*.proxy first. HTTP_PROXY
# here only kicks in for code paths that build a transport without consulting
# the config file (currently: none, but reserved for future tooling).
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# --- Resource limits -------------------------------------------------
BACKEND_MEM_LIMIT=512m
BACKEND_CPUS=1.0
WEB_MEM_LIMIT=512m
WEB_CPUS=1.0
MYSQL_MEM_LIMIT=1g
MYSQL_CPUS=1.0
